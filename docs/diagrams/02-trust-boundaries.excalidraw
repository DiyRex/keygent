   "link": null,
   "locked": false,
   "text": "• connect to the broker socket / pipe\n• run any keygent subcommand, forge hook JSON\n• fake a TTY, unset CLAUDECODE\n• edit .keygent.toml, agent settings, shell rc\n• replace binaries in user-writable dirs\n• read a child's env while it runs (T3)\n• act as a software WebAuthn client\n• copy vault.kgt for offline guessing\n• drive the browser / UI",
   "originalText": "• connect to the broker socket / pipe\n• run any keygent subcommand, forge hook JSON\n• fake a TTY, unset CLAUDECODE\n• edit .keygent.toml, agent settings, shell rc\n• replace binaries in user-writable dirs\n• read a child's env while it runs (T3)\n• act as a software WebAuthn client\n• copy vault.kgt for offline guessing\n• drive the browser / UI",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
