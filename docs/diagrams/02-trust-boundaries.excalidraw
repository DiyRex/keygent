   "boundElements": [],
   "updated": 1763164800000,
   "link": null,
   "locked": false,
   "text": "• know your passphrase\n• pass Touch ID / Windows Hello / FIDO2 PIN\n• read broker memory (locked, non-dumpable,\n  hardened runtime / mitigation policies)\n• get plaintext from any broker request\n  (Reveal: CLI + passphrase proof only)\n• approve a grant (broker observes UV,\n  passphrase or passkey itself)\n• swap a pinned binary (hash mismatch)\n• impersonate the broker to the CLI",
   "originalText": "• know your passphrase\n• pass Touch ID / Windows Hello / FIDO2 PIN\n• read broker memory (locked, non-dumpable,\n  hardened runtime / mitigation policies)\n• get plaintext from any broker request\n  (Reveal: CLI + passphrase proof only)\n• approve a grant (broker observes UV,\n  passphrase or passkey itself)\n• swap a pinned binary (hash mismatch)\n• impersonate the broker to the CLI",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
